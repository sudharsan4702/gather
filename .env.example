# ==============================================================================
# Catane Gather - Root Environment Configuration Template
# ==============================================================================
# This root file provides a centralized reference for both Backend and Frontend.
# For standalone local development:
#   - Backend reads from:  ./backend/.env
#   - Frontend reads from: ./frontend/.env
# If using Docker Compose or a unified launcher from the project root,
# this root .env can be used to inject variables into all services.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Settings (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_TITLE=Catane Gather

# ------------------------------------------------------------------------------
# Backend Server & Database Settings
# ------------------------------------------------------------------------------
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/catane_gather_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here
DDL_AUTO=update
SHOW_SQL=false
FORMAT_SQL=false

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# File Uploads
# ------------------------------------------------------------------------------
UPLOAD_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway & Webhooks
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------------------------------------------
# SMTP Email Configuration
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_specific_password
MAIL_FROM=noreply@catanegather.com
MAIL_SENDER_NAME=Catane Gather

# ==============================================================================
# Catane Gather - Frontend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Duplicate this file and rename it to '.env':
#      cp .env.example .env     (Linux / macOS)
#      copy .env.example .env   (Windows PowerShell / CMD)
# 2. In Vite applications, only variables prefixed with 'VITE_' are exposed
#    to client-side browser code via import.meta.env.
# ==============================================================================

# Backend API Base URL (without trailing slash)
# Points to your Spring Boot REST API server
VITE_API_BASE_URL=http://localhost:8080

# Application Branding
VITE_APP_TITLE=Catane Gather

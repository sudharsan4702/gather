# ==============================================================================
# Catane Gather - Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Duplicate this file and rename it to '.env':
#      cp .env.example .env     (Linux / macOS)
#      copy .env.example .env   (Windows PowerShell / CMD)
# 2. Replace the placeholder values below with your local or production credentials.
# 3. DO NOT commit the actual '.env' file to Git / version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# HTTP port for the Spring Boot REST API
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# JDBC Connection URL pointing to PostgreSQL database
DB_URL=jdbc:postgresql://localhost:5432/catane_gather_db

# Database Authentication Credentials
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# Hibernate DDL Strategy: 'update', 'validate', 'none', or 'create-drop'
DDL_AUTO=update

# SQL Logging (set to true for debugging queries in console)
SHOW_SQL=false
FORMAT_SQL=false

# ------------------------------------------------------------------------------
# 3. Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# Cryptographically secure 256-bit (or 512-bit) hex key for signing HMAC-SHA JWTs.
# Generate a new random secret with: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Token Expiration in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. File Storage & Uploads
# ------------------------------------------------------------------------------
# Base URL prepended to uploaded cover photos, invite images, and attachments.
# Leave empty for relative paths, or set to your API domain (e.g. http://localhost:8080)
UPLOAD_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 5. Razorpay Payment Gateway & Webhook Credentials
# ------------------------------------------------------------------------------
# Retrieve test or production API keys from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Webhook Secret configured in your Razorpay Dashboard under Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------------------------------------------
# 6. SMTP Email Configuration (Google Gmail / SendGrid / Custom SMTP)
# ------------------------------------------------------------------------------
# SMTP Host and Port (587 for TLS, 465 for SSL)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587

# SMTP Authentication (For Gmail, use a 16-character App Password)
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_specific_password

# Outgoing Email Sender Address and Display Name
MAIL_FROM=noreply@catanegather.com
MAIL_SENDER_NAME=Catane Gather

# ------------------------------------------------------------------------------
# 7. Resend Email Configuration (Recommended for Render & Cloud Deployments)
# ------------------------------------------------------------------------------
# Bypasses blocked cloud SMTP ports (25, 465, 587) using HTTPS REST API on Port 443.
# Free 3,000 emails/month from https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Catane Gather <onboarding@resend.dev>

